# Copy this file to .env and fill it in. The bot works with any OpenAI-compatible API.

# --- Variant 1: local model in Ollama (default) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local-llm
LLM_MODEL=qwen3:8b

# --- Variant 2: OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=<your key>
# LLM_MODEL=gpt-5-mini
# LLM_TEMPERATURE=1
# LLM_REASONING_EFFORT=minimal

# Protection against prompt injections in documents (1 = on, 0 = off)
# GUARD_PREPROMPT=1
# GUARD_CHUNK_FILTER=1
# GUARD_SANITIZE=1

# Retrieval settings
# TOP_K=5
# MIN_SCORE=0.5
